# Лабораторный Mailu. Не для публичного сервера.
SECRET_KEY=LabMailuSecret16
SUBNET=192.168.203.0/24
DOMAIN=information-security.org
HOSTNAMES=localhost
POSTMASTER=admin
TLS_FLAVOR=notls
SESSION_COOKIE_SECURE=False
AUTH_RATELIMIT_IP=10000/hour
AUTH_RATELIMIT_USER=10000/day
AUTH_RATELIMIT_EXEMPTION=192.168.203.0/24
DISABLE_STATISTICS=True

ADMIN=true
WEBMAIL=snappymail
API=true
WEBDAV=none
ANTIVIRUS=none
SCAN_MACROS=false
FETCHMAIL_ENABLED=False
FULL_TEXT_SEARCH=off
FULL_TEXT_SEARCH_ATTACHMENTS=false

MESSAGE_SIZE_LIMIT=50000000
RECIPIENT_DELIMITER=+
WELCOME=false
COMPRESSION=
PORTS=25,80

WEBROOT_REDIRECT=/admin
WEB_ADMIN=/admin
WEB_WEBMAIL=/webmail
WEB_API=/api
SITENAME=InformationSecurity Mail
WEBSITE=http://localhost:3000

CREDENTIAL_ROUNDS=12
LOG_LEVEL=INFO
TZ=Etc/UTC
DEFAULT_SPAM_THRESHOLD=80
API_TOKEN=LabMailuApiTokenChangeMe

INITIAL_ADMIN_ACCOUNT=admin
INITIAL_ADMIN_DOMAIN=information-security.org
INITIAL_ADMIN_PW=Admin#12345
INITIAL_ADMIN_MODE=ifmissing
